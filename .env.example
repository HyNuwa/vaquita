# Copiá este archivo a .env y completalo. .env está en .gitignore: nunca lo subas.

# --- Wallet del agente -------------------------------------------------------
# Clave privada de la wallet DEL AGENTE (no tu wallet personal).
# Esta misma wallet registra la identidad ERC-8004.
AGENT_PRIVATE_KEY=0x

# --- Atribución ERC-8021 -----------------------------------------------------
# El código que te da Loops House al inscribirte (formato celo_xxxxxxxx).
# Sin código válido, el agente no firma ninguna transacción.
ATTRIBUTION_CODE=celo_xxxxxxxx
# Opcional: owner/repo de GitHub. Si el código fue derivado del repo,
# el agente avisa al arrancar si no coincide (codeFromRepo).
GITHUB_REPO=

# --- Red ---------------------------------------------------------------------
# Solo Celo mainnet. El agente verifica eth_chainId === 42220 antes de firmar.
CELO_RPC_URL=https://forno.celo.org

# --- Gas con fee abstraction -------------------------------------------------
# Moneda en la que se paga el gas. Opciones: USDC | USDT | USAT | USDm
# (los wFIAT de Ripio NO son fee currency). La wallet necesita unos centavos de esta moneda.
FEE_CURRENCY=USDC

# --- Destinatarios permitidos ------------------------------------------------
# alias:direccion separados por coma. El LLM solo puede elegir un alias de esta lista.
ALLOWED_RECIPIENTS=prueba:0x0000000000000000000000000000000000000000

# --- Modo real ---------------------------------------------------------------
# Por defecto todo corre en MODO ENSAYO (firma pero no transmite).
# Para mover dinero real, el valor tiene que ser EXACTAMENTE esta frase:
# LIVE_PAYMENTS=si-muevo-plata-real
LIVE_PAYMENTS=

# --- Identidad ERC-8004 ------------------------------------------------------
# URL pública (HTTPS) del archivo de registro. Plantilla en public/agent.json
AGENT_URI=
