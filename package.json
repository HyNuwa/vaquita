{
  "name": "vaquita",
  "version": "0.1.0",
  "description": "Agente de juntas, tandas y vacas en wFIAT (Ripio) sobre Celo mainnet",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run typecheck && npm test",
    "preflight": "tsx packages/core/scripts/preflight.ts",
    "pago:primero": "tsx packages/core/scripts/send-first-wars.ts",
    "identidad:registrar": "tsx packages/core/scripts/register-agent.ts",
    "ramp:link": "tsx packages/core/scripts/ramp-link.ts",
    "tx:verificar": "tsx packages/core/scripts/verify-tx.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
